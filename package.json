{
  "name": "librarysystem-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end and API test suite for the LibrarySystem book-lending stack",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs db",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:ui": "playwright test --project=ui",
    "test:e2e:headed": "playwright test --project=ui --headed",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/mssql": "9.1.11",
    "@types/node": "25.5.0",
    "mssql": "12.2.1",
    "typescript": "6.0.2"
  }
}
