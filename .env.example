# Copy this file to .env. It is git-ignored; .env.example is the committed template.
#
# These are throwaway credentials for a disposable local test database. Nothing here is a
# secret, and nothing here reaches any environment but your own machine and CI's ephemeral
# runner.

# SQL Server enforces password complexity: at least eight characters drawn from three of
# uppercase, lowercase, digits and symbols. A container given a password that fails this
# exits a few seconds after starting, with the reason only in `docker compose logs db`.
MSSQL_SA_PASSWORD=LocalTestPassw0rd

# The API reads this and it wins over appsettings.Development.json, because environment
# variables are layered after JSON files in ASP.NET Core's configuration order. That is why
# the vendored appsettings file can keep pointing at SQL Express and stay untouched.
#
# Note there is no backslash anywhere in it. Targeting host,port rather than the .\INSTANCE
# form keeps this string safe to write, echo and template from any shell.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=LibrarySystemDb;User Id=sa;Password=LocalTestPassw0rd;TrustServerCertificate=True
